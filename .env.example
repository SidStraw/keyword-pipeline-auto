# Serper API Key - Get from https://serper.dev/
# Used for Google search suggestions and competition analysis
SERPER_API_KEY=your_serper_api_key_here

# Google Apps Script Web App URL
# Used to save keywords to Google Sheets
GAS_WEB_APP_URL=your_gas_web_app_url_here

# Custom API Key for GAS Web App authentication
MY_CUSTOM_API_KEY=your_custom_api_key_here

# Google Gemini API Key - Get from https://aistudio.google.com/
# Used for AI-powered niche idea generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Seed keywords (comma-separated)
# If not provided, AI will generate them automatically
# Example: SEED_KEYWORDS=keyword1,keyword2,keyword3
SEED_KEYWORDS=

# Optional: Gemini Model (default: gemini-2.5-flash)
# Other options: gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
