# Serper API Key - Get from https://serper.dev/
# Used for Google search suggestions and competition analysis
SERPER_API_KEY=your_serper_api_key_here

# Google Apps Script Web App URL
# Used to save keywords to Google Sheets
GAS_WEB_APP_URL=your_gas_web_app_url_here

# Custom API Key for GAS Web App authentication
MY_CUSTOM_API_KEY=your_custom_api_key_here

# GitHub Personal Access Token with "Copilot Requests" permission
# Create at: https://github.com/settings/personal-access-tokens/new
# Required: Repository access = Public repositories, Permissions = Copilot Requests
GH_TOKEN=your_github_pat_here

# Optional: Seed keywords (comma-separated)
# If not provided, AI will generate them automatically
# Example: SEED_KEYWORDS=keyword1,keyword2,keyword3
SEED_KEYWORDS=

# Optional: Copilot Model (default: claude-haiku-4.5)
# Other options: claude-sonnet-4.5, gpt-5, gpt-5.1
COPILOT_MODEL=claude-haiku-4.5

# Optional: Discord Webhook URL for pipeline notifications
DISCORD_WEBHOOK_URL=

# Optional: Google Custom Search API (for precise competition data)
# Get API key from: https://console.cloud.google.com/apis/credentials
# Get CSE ID from: https://cse.google.com/cse/all
# Free tier: 100 queries/day
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
